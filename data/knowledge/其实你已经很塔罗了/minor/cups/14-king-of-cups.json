  "knowledge": [
    {
      "id": "king-of-cups-upright-general",
      "orientation": "upright",
      "topic": "general",
      "content": "圣杯国王正位表示通过情感与创造力的训练、自律和坚持获得成功，把想象与实际努力结合后会产生回报。"
    },
    {
      "id": "king-of-cups-upright-element",
      "orientation": "upright",
      "topic": "element",
      "content": "圣杯国王代表水元素中的土：水提供想象、情感和直觉，土提供稳定、耐心、训练与落实能力。"
    },
    {
      "id": "king-of-cups-upright-discipline",
      "orientation": "upright",
      "topic": "discipline",
      "content": "圣杯国王正位不会只凭一时灵感行动，而能持续投入，使创意逐渐形成具体成果。"
    },
    {
      "id": "king-of-cups-upright-intuition",
      "orientation": "upright",
      "topic": "intuition",
      "content": "圣杯国王正位的重要决定会参考经过经验检验的直觉，即使在事业问题中，也能从敏锐观察和预感中发现方向。"
    },
    {
