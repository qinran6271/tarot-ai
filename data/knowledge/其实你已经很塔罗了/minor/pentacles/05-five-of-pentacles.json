  "knowledge": [
    {
      "id": "five-of-pentacles-upright-general",
      "orientation": "upright",
      "topic": "general",
      "content": "五角星五正位表示物质困难、孤立，以及与原本能够提供支持、意义或滋养的事物失去连接。"
    },
    {
      "id": "five-of-pentacles-upright-change",
      "orientation": "upright",
      "topic": "change",
      "content": "塔罗中的五通常与改变、冲突和不稳定有关，五角星五把这些主题带到物质生活与安全感。"
    },
    {
      "id": "five-of-pentacles-upright-hardship",
      "orientation": "upright",
      "topic": "hardship",
      "content": "五角星五正位可能表示财务压力、资源不足、失业、疾病、疲惫、孤独或缺少支持。"
    },
    {
      "id": "five-of-pentacles-upright-isolation",
      "orientation": "upright",
      "topic": "isolation",
      "content": "五角星五正位可以表示即使身在人群或关系中，仍感觉无人理解、无法求助或缺少归属。"
    },
    {
      "id": "five-of-pentacles-upright-narrow-focus",
      "orientation": "upright",
      "topic": "stress",
      "content": "长期挣扎会使注意力集中于眼前威胁，降低辨认资源与其他选择的能力。"
    },
    {
      "id": "five-of-pentacles-upright-no-blame",
      "orientation": "upright",
      "topic": "safety_caution",
      "content": "压力下看不见机会可能与羞耻、创伤或信息不足有关，不应被解释为当事人故意忽略帮助。"
    },
    {
      "id": "five-of-pentacles-upright-real-causes",
      "orientation": "upright",
      "topic": "safety_caution",
      "content": "贫困、疾病和孤立可能来自经济、医疗、家庭、工作与社会环境等真实因素，不能简单归因于精神空虚或消极思想。"
    },
    {
      "id": "five-of-pentacles-upright-support-resources",
      "orientation": "upright",
      "topic": "support",
      "content": "可检查亲友、社区组织、医疗服务、社会福利、债务咨询、职业支持或心理帮助等现实资源。"
    },
    {
      "id": "five-of-pentacles-upright-accept-help",
      "orientation": "upright",
      "topic": "advice",
      "content": "五角星五正位提醒人，接受援助不是失败，而是应对资源不足的实际行动。"
    },
    {
      "id": "five-of-pentacles-upright-beliefs",
      "orientation": "upright",
      "topic": "belief",
      "content": "可以检视“我只能忍耐”“求助等于软弱”或“我没有选择”等信念是否仍然提供支持。"
    },
    {
      "id": "five-of-pentacles-upright-belief-reality",
      "orientation": "upright",
      "topic": "interpretation",
      "content": "改变信念可能扩大行动空间，但不能代替金钱、医疗、住房和制度支持等现实资源。"
    },
    {
      "id": "five-of-pentacles-symbolism-two-figures",
      "orientation": "neutral",
      "topic": "symbolism",
      "content": "寒冷中艰难前行的两个人象征贫困、疲惫、身体脆弱，以及同行却依然孤独的状态。"
    },
    {
      "id": "five-of-pentacles-symbolism-window",
      "orientation": "neutral",
      "topic": "symbolism",
      "content": "身后的教堂彩窗象征可能存在的庇护、社群、意义或援助，但当事人暂时没有看见或无法接近。"
    },
    {
      "id": "five-of-pentacles-symbolism-spiritual-support",
      "orientation": "neutral",
      "topic": "spirituality",
      "content": "精神、信仰或价值支持可以帮助人应对困境，但不是贫困、疾病或孤立的唯一原因与解决方案。"
    },
    {
      "id": "five-of-pentacles-upright-career",
      "orientation": "upright",
      "topic": "career",
      "content": "在事业中，五角星五正位可能表示失业风险、收入不足、工作缺乏意义，或对当前职业长期失去兴趣。"
    },
    {
      "id": "five-of-pentacles-upright-career-constraints",
      "orientation": "upright",
      "topic": "career_advice",
      "content": "离职并非总是安全或可行，应先考虑收入、保险、照护、签证及其他现实约束。"
    },
    {
      "id": "five-of-pentacles-upright-career-plan",
      "orientation": "upright",
      "topic": "career_advice",
      "content": "可以通过学习技能、更新履历、储备资金、寻找内部调动或探索职位，逐步建立工作替代方案。"
    },
    {
      "id": "five-of-pentacles-health-caution",
      "orientation": "neutral",
      "topic": "safety_caution",
      "content": "塔罗不能诊断疾病，也不能把病痛归因于精神空虚或态度；身体症状应由医疗专业人员评估。"
    },
    {
      "id": "five-of-pentacles-basic-needs",
      "orientation": "neutral",
      "topic": "safety_caution",
      "content": "若食物、住房、保暖或人身安全无法保障，应优先联系当地社会服务、社区援助或紧急资源。"
    },
    {
      "id": "five-of-pentacles-upright-relationship",
      "orientation": "upright",
      "topic": "relationship",
      "content": "在亲密关系中，五角星五正位可能表示分离、情感疏离，或即使仍在一起也感到孤独和缺少支持。"
    },
    {
      "id": "five-of-pentacles-upright-relationship-causes",
      "orientation": "upright",
      "topic": "relationship",
      "content": "关系疏离可能来自沟通中断、长期压力、经济困难、照护负担、价值差异或未被回应的需求。"
    },
    {
      "id": "five-of-pentacles-upright-relationship-advice",
      "orientation": "upright",
      "topic": "relationship_advice",
      "content": "适合明确表达孤独感和具体需要，并观察双方是否愿意共同修复关系。"
    },
    {
      "id": "five-of-pentacles-upright-relationship-safety",
      "orientation": "upright",
      "topic": "safety_caution",
      "content": "若关系中存在忽视、控制或虐待，应优先考虑安全并寻求外部专业支持。"
    },
    {
      "id": "five-of-pentacles-reversed-general",
      "orientation": "reversed",
      "topic": "general",
      "content": "五角星五逆位表示最困难的阶段可能开始过去，新的资源、选择或帮助逐渐变得可见。"
    },
    {
      "id": "five-of-pentacles-reversed-liberation",
      "orientation": "reversed",
      "topic": "freedom",
      "content": "五角星五逆位可能象征从限制性关系、工作或处境中获得解放。"
    },
    {
      "id": "five-of-pentacles-reversed-open-mind",
      "orientation": "reversed",
      "topic": "perspective",
      "content": "逆位表示愿意用不同方式处理问题，不再把过去的方法视为唯一选择。"
    },
    {
      "id": "five-of-pentacles-reversed-action",
      "orientation": "reversed",
      "topic": "recovery",
      "content": "恢复通常来自观点改变与现实行动结合，例如接受援助、调整计划、建立支持网络或离开不健康环境。"
    },
    {
      "id": "five-of-pentacles-reversed-no-automatic-change",
      "orientation": "reversed",
      "topic": "interpretation",
      "content": "五角星五逆位不保证外界自动改善，新机会仍需要被识别、评估并采取行动。"
    },
    {
      "id": "five-of-pentacles-reversed-reconnection",
      "orientation": "reversed",
      "topic": "connection",
      "content": "逆位可能表示逐渐摆脱羞耻与孤立，并愿意重新与人和支持系统连接。"
    },
    {
      "id": "five-of-pentacles-reversed-next-step",
      "orientation": "reversed",
      "topic": "advice",
      "content": "确认目前已经可用的帮助，并采取一个具体、可负担且能提高安全感的下一步。"
    }
  ]
}
