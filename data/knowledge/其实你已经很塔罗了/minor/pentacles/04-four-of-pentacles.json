  "knowledge": [
    {
      "id": "four-of-pentacles-upright-general",
      "orientation": "upright",
      "topic": "general",
      "content": "五角星四正位表示节省金钱或精力、巩固资源，并在安全感与开放生活之间寻找平衡。"
    },
    {
      "id": "four-of-pentacles-upright-consolidation",
      "orientation": "upright",
      "topic": "stability",
      "content": "塔罗中的四具有巩固主题，五角星四正位则强调财务、物质条件和现实结构的稳定。"
    },
    {
      "id": "four-of-pentacles-upright-saving",
      "orientation": "upright",
      "topic": "finance",
      "content": "五角星四正位可能表示储蓄、控制消费、偿还债务或保护已经拥有的资源。"
    },
    {
      "id": "four-of-pentacles-upright-energy",
      "orientation": "upright",
      "topic": "energy",
      "content": "五角星四正位也可表示保存精力、减少不必要承诺，并避免过度消耗。"
    },
    {
      "id": "four-of-pentacles-upright-cash-flow",
      "orientation": "upright",
      "topic": "finance",
      "content": "通过量入为出、增加收入或降低支出，可以逐渐改善现金流并建立财务基础。"
    },
    {
      "id": "four-of-pentacles-upright-security",
      "orientation": "upright",
      "topic": "security",
      "content": "五角星四正位可能表示需要持有金钱或物质资源才能感到安全和踏实。"
    },
    {
      "id": "four-of-pentacles-upright-isolation",
      "orientation": "upright",
      "topic": "shadow",
      "content": "安全需求过强可能使人难以分享、投入生活或接受变化，并逐渐与他人疏离。"
    },
    {
      "id": "four-of-pentacles-upright-self-worth",
      "orientation": "upright",
      "topic": "self_worth",
      "content": "五角星四提醒人，金钱和资源应当服务于生活，个人价值不能只由财富与所有物定义。"
    },
    {
      "id": "four-of-pentacles-symbolism-holding-coins",
      "orientation": "neutral",
      "topic": "symbolism",
      "content": "人物的头、手和脚都与五角星相连，象征注意力被安全、所有权和控制占据。"
    },
    {
      "id": "four-of-pentacles-symbolism-solitude",
      "orientation": "neutral",
      "topic": "symbolism",
      "content": "独坐的人物象征保护财富可能带来的隔离，以及物质安全与人际连接之间的张力。"
    },
    {
      "id": "four-of-pentacles-upright-travel",
      "orientation": "upright",
      "topic": "travel",
      "content": "在旅行问题中，五角星四正位可能表示设定预算，并选择负担得起的交通、住宿和活动。"
    },
    {
      "id": "four-of-pentacles-upright-business",
      "orientation": "upright",
      "topic": "business",
      "content": "在事业或商业中，五角星四正位可能表示稳定、保守与重视风险控制。"
    },
    {
      "id": "four-of-pentacles-upright-negotiation",
      "orientation": "upright",
      "topic": "negotiation",
      "content": "五角星四正位可能表示谈判方对新意见、条件变化或改变的接受度较低。"
    },
    {
